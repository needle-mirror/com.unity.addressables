<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True" xmlns:ba="UnityEditor.Build.Analysis">
    <ui:ScrollView name="SummaryTabScroll" class="SummaryTabScroll">
        <ba:BuildHeader name="SummaryTabHeader"/>

        <ui:VisualElement name="SummaryTabContentDirectories"/>

        <ba:StatCardRow name="SummaryTabStatCards">
            <ba:StatCard name="SummaryTabStatCardBundleSize" label="Total Bundle Size" icon="BuildSize"/>
            <ba:StatCard name="SummaryTabStatCardDuration" label="Build Duration" icon="Duration"/>
            <ba:StatCard name="SummaryTabStatCardBundles" label="Bundles"/>
            <ba:StatCard name="SummaryTabStatCardAssets" label="Assets" icon="Assets"/>
        </ba:StatCardRow>

        <ui:VisualElement name="SummaryTabSections" class="SummaryTabSections">
            <ba:BuildSection name="SummaryTabBuildDetailsSection" title="Build Details">
                <ba:BuildDetailsGrid name="SummaryTabDetailsGrid">
                    <ba:BuildDetailsColumn side="Left">
                        <ba:BuildDetailsRow label="Addressables:" value-name="SummaryTabDetailValue_Addressables"/>
                        <ba:BuildDetailsRow label="Assets pulled:" value-name="SummaryTabDetailValue_Assets pulled"/>
                        <ba:BuildDetailsRow label="Package Version:" value-name="SummaryTabDetailValue_Package Version"/>
                        <ba:BuildDetailsRow label="Editor Version:" value-name="SummaryTabDetailValue_Editor Version"/>
                        <ba:BuildDetailsRow label="Player Build Version:" value-name="SummaryTabDetailValue_Player Build Version"/>
                    </ba:BuildDetailsColumn>
                    <ba:BuildDetailsColumn side="Right">
                        <ba:BuildDetailsRow label="Addressable Profile:" value-name="SummaryTabDetailValue_Addressable Profile"/>
                        <ba:BuildDetailsRow label="Local Catalog(s):" value-name="SummaryTabDetailValue_Local Catalog(s)"/>
                        <ba:BuildDetailsRow label="Remote Catalog(s):" value-name="SummaryTabDetailValue_Remote Catalog(s)"/>
                        <ba:BuildDetailsRow label="Remote Catalog Location:" value-name="SummaryTabDetailValue_Remote Catalog Location"/>
                        <ba:BuildDetailsRow label="Local Catalog Location:" value-name="SummaryTabDetailValue_Local Catalog Location">
                            <ui:Button name="SummaryTabShowLocalCatalogButton" class="info-action-button"/>
                        </ba:BuildDetailsRow>
                        <ba:BuildDetailsRow label="Related Builds:" value-name="SummaryTabDetailValue_Related Builds">
                            <ba:RelatedBuildLinks name="SummaryTabRelatedBuilds"/>
                        </ba:BuildDetailsRow>
                    </ba:BuildDetailsColumn>
                </ba:BuildDetailsGrid>
            </ba:BuildSection>

            <ui:VisualElement name="SummaryTabPotentialIssues" class="SummaryTabSection SummaryTabIssuesCard">
                <ui:VisualElement class="SummaryTabIssuesBody">
                    <ui:Image name="SummaryTabIssuesIcon" class="SummaryTabIssuesIcon"/>
                    <ui:VisualElement class="SummaryTabIssuesText">
                        <ui:Label name="SummaryTabIssuesMessage" class="SummaryTabIssuesMessage" selectable="true"/>
                        <ui:Label name="SummaryTabIssuesDetail" class="SummaryTabIssuesDetail" selectable="true"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="SummaryTabIssuesActions">
                    <ui:Button name="SummaryTabIssuesViewButton" text="View"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView>
</ui:UXML>
