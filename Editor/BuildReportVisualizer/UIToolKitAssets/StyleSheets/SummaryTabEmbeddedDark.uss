/* Theme values for the Summary tab, matching Build Analysis' dark theme. Declared on the scroll
   view because this sheet is attached to the tab root, so :root would not match anything here. */
.SummaryTabScroll {
    --summary-tab-status-success-text: #14D368;
    --summary-tab-status-success-border: rgba(20, 211, 104, 0.3);
    --summary-tab-status-success-background: rgba(20, 211, 104, 0.1);
    --summary-tab-status-failed-text: #FF534A;
    --summary-tab-status-failed-border: rgba(255, 83, 74, 0.3);
    --summary-tab-status-failed-background: rgba(255, 83, 74, 0.1);
    --summary-tab-kpi-icon-build-size: resource('BuildAnalysis/Icons/d_BuildSize.png');
    --summary-tab-kpi-icon-duration: resource('BuildAnalysis/Icons/d_Time.png');
    --summary-tab-kpi-icon-bundles: resource('Packages/com.unity.addressables/Editor/Icons/Groups Window/Dark Theme/Asset Bundle/d_AssetBundle.png');
    --summary-tab-kpi-icon-assets: resource('BuildAnalysis/Icons/d_Draft.png');
}
