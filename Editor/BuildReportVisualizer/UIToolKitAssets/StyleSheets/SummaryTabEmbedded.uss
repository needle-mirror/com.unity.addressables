/* The header, stat cards and Build Details bring their own sheets from Build Analysis. */

.SummaryTabScroll {
    flex-grow: 1;
    padding: 0;
    background-color: var(--unity-colors-window-secondary-background);
    overflow: hidden;
}

/* ===== Stat card icons ===== */

/* Build Analysis has no bundles icon. */
.build-analysis-window--dark #SummaryTabStatCardBundles .stat-card__icon {
    background-image: resource('Packages/com.unity.addressables/Editor/Icons/Groups Window/Dark Theme/Asset Bundle/d_AssetBundle.png');
}

.build-analysis-window--light #SummaryTabStatCardBundles .stat-card__icon {
    background-image: resource('Packages/com.unity.addressables/Editor/Icons/Groups Window/Light Theme/Asset Bundle/AssetBundle.png');
}

/* ===== Sections ===== */

.SummaryTabSections {
    flex-direction: column;
    flex-wrap: nowrap;
    margin-bottom: 8px;
    padding: 8px;
}

.SummaryTabSection {
    padding: 0;
    margin-bottom: 12px;
    background-color: var(--unity-colors-inspector_titlebar-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 4px;
    flex-shrink: 0;
}

/* ===== Content Directories banner ===== */

/* Sits directly under the header, so it insets to the same 8px as the stat card row below it and
   leaves the vertical gap to that row's own top padding. Its slot stays bare so it costs nothing
   when the build has no content directories. */
.SummaryTabContentDirectoriesBanner {
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 8px;
    margin-bottom: 0;
    padding: 5px;
    flex-shrink: 0;
}

.SummaryTabContentDirectoriesBanner .unity-help-box__label {
    font-size: 12px;
}

/* ===== Potential Issues card ===== */

.SummaryTabIssuesCard {
    flex-direction: column;
    padding: 8px;
}

.SummaryTabIssuesBody {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
}

.SummaryTabIssuesIcon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 8px;
    margin-top: 1px;
}

.SummaryTabIssuesText {
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
}

.SummaryTabIssuesMessage {
    font-size: 11.5px;
    white-space: normal;
}

.SummaryTabIssuesDetail {
    font-size: 11.5px;
    white-space: normal;
    opacity: 0.8;
    margin-top: 6px;
}

.SummaryTabIssuesActions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 8px;
}
